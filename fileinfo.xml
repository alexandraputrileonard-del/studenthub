script.js — StudentHub Portal Mahasiswa Modern
 * ================================================
 * Modul:
 *  1. Navbar: sticky scroll + active link highlight
 *  2. Hamburger Menu (mobile)
 *  3. Smooth Scroll untuk semua anchor link
 *  4. Reveal Animation saat scroll (Intersection Observer)
 *  5. Filter Tugas (All / Belum / Proses / Selesai)
 *  6. Form Kontak — validasi + simulasi submit
 *  7. Back To Top button
 *  8. Highlight baris jadwal hari ini
 */

"use strict";

/* ============================================================
   1. NAVBAR — sticky effect on scroll + active link update
   ============================================================ */

const navbar  = document.getElementById("navbar");
const navLinks = document.querySelectorAll(".nav-link");
const sections = document.querySelectorAll("section[id]");

/**
 * Tambahkan class "scrolled" pada navbar saat halaman di-scroll.
 * Update nav-link aktif sesuai section yang sedang terlihat.
 */
function handleNavbarScroll() {
  // Sticky style
  if (window.scrollY > 20) {
    navbar.classList.add("scrolled");
  } else {
    navbar.classList.remove("scrolled");
  }

  // Highlight link aktif: cari section yang posisinya paling dekat viewport top
  let currentSectionId = "";
  sections.forEach(section => {
    const sectionTop = section.offsetTop - 90; // offset untuk fixed navbar
    if (window.scrollY >= sectionTop) {
      currentSectionId = section.getAttribute("id");
    }
  });

  navLinks.forEach(link => {
    link.classList.remove("active");
    if (link.getAttribute("href") === `#${currentSectionId}`) {
      link.classList.add("active");
    }
  });
}

window.addEventListener("scroll", handleNavbarScroll, { passive: true });
// Jalankan sekali saat load agar kondisi awal benar
handleNavbarScroll();

/* ============================================================
   2. HAMBURGER MENU (mobile)
   ============================================================ */

const hamburger  = document.getElementById("hamburger");
const mobileMenu = document.getElementById("mobile-menu");
const mobileLinks = document.querySelectorAll(".mobile-link");

/** Toggle buka / tutup menu mobile */
function toggleMobileMenu() {
  const isOpen = mobileMenu.classList.toggle("open");
  hamburger.classList.toggle("open", isOpen);
  hamburger.setAttribute("aria-expanded", String(isOpen));
}

hamburger.addEventListener("click", toggleMobileMenu);

// Tutup menu saat link diklik
mobileLinks.forEach(link => {
  link.addEventListener("click", () => {
    mobileMenu.classList.remove("open");
    hamburger.classList.remove("open");
    hamburger.setAttribute("aria-expanded", "false");
  });
});

// Tutup menu saat klik di luar area navbar
document.addEventListener("click", (e) => {
  if (!navbar.contains(e.target) && mobileMenu.classList.contains("open")) {
    mobileMenu.classList.remove("open");
    hamburger.classList.remove("open");
    hamburger.setAttribute("aria-expanded", "false");
  }
});

/* ============================================================
   3. SMOOTH SCROLL untuk semua anchor (#)
   ============================================================ */

/**
 * Scroll halus ke elemen target dengan memperhitungkan
 * tinggi navbar yang fixed.
 * @param {string} targetId - ID elemen tujuan
 */
function smoothScrollTo(targetId) {
  const target = document.querySelector(targetId);
  if (!target) return;

  const navHeight = navbar.offsetHeight;
  const targetTop = target.getBoundingClientRect().top + window.scrollY - navHeight;

  window.scrollTo({ top: targetTop, behavior: "smooth" });
}

// Pasang handler pada semua link anchor dalam halaman
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
  anchor.addEventListener("click", (e) => {
    const href = anchor.getAttribute("href");
    // Abaikan link kosong atau hanya "#"
    if (!href || href === "#") return;
    e.preventDefault();
    smoothScrollTo(href);
  });
});

/* ============================================================
   4. REVEAL ANIMATION (Intersection Observer)
   ============================================================ */

/**
 * Elemen dengan class .reveal akan muncul dengan animasi
 * fadeUp/fadeRight saat memasuki viewport.
 */
const revealObserver = new IntersectionObserver(
  (entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        // Hentikan observasi setelah elemen tampil (one-shot)
        revealObserver.unobserve(entry.target);
      }
    });
  },
  {
    threshold: 0.12,   // tampilkan saat 12% elemen terlihat
    rootMargin: "0px 0px -40px 0px"
  }
);

// Observasi semua elemen .reveal
document.querySelectorAll(".reveal").forEach(el => revealObserver.observe(el));

/* ============================================================
   5. FILTER TUGAS
   ============================================================ */

const filterPills  = document.querySelectorAll(".filter-pill");
const tugasCards   = document.querySelectorAll(".tugas-card");

/**
 * Tampilkan hanya tugas-card yang sesuai dengan status filter.
 * @param {string} status - "all" | "belum" | "proses" | "selesai"
 */
function filterTugas(status) {
  tugasCards.forEach(card => {
    const cardStatus = card.getAttribute("data-status");
    const shouldShow = status === "all" || cardStatus === status;

    if (shouldShow) {
      card.style.display = "";
      // Trigger animasi ulang dengan re-add class
      card.style.animation = "none";
      // Force reflow (trick agar animasi bisa diulang)
      void card.offsetHeight;
      card.style.animation = "";
    } else {
      card.style.display = "none";
    }
  });
}

filterPills.forEach(pill => {
  pill.addEventListener("click", () => {
    // Update active pill
    filterPills.forEach(p => p.classList.remove("active"));
    pill.classList.add("active");

    const status = pill.getAttribute("data-status");
    filterTugas(status);
  });
});

/* ============================================================
   6. FORM KONTAK — Validasi & Simulasi Submit
   ============================================================ */

const contactForm = document.getElementById("contact-form");
const sendBtn     = document.getElementById("send-btn");
const btnText     = document.getElementById("btn-text");
const btnLoading  = document.getElementById("btn-loading");
const formSuccess = document.getElementById("form-success");

/**
 * Definisi field yang perlu divalidasi.
 * type: "text" | "email" | "textarea"
 */
const formFields = [
  {
    id:        "nama",
    errorId:   "error-nama",
    label:     "Nama",
    minLength: 3,
    type:      "text"
  },
  {
    id:      "email",
    errorId: "error-email",
    label:   "Email",
    type:    "email"
  },
  {
    id:        "subjek",
    errorId:   "error-subjek",
    label:     "Subjek",
    minLength: 5,
    type:      "text"
  },
  {
    id:        "pesan",
    errorId:   "error-pesan",
    label:     "Pesan",
    minLength: 10,
    type:      "textarea"
  },
];

/**
 * Validasi satu field.
 * @param {{id, errorId, label, minLength?, type}} field
 * @returns {boolean} true jika valid
 */
function validateField(field) {
  const inputEl = document.getElementById(field.id);
  const errorEl = document.getElementById(field.errorId);
  const value   = inputEl.value.trim();

  let errorMsg = "";

  if (!value) {
    errorMsg = `${field.label} wajib diisi.`;
  } else if (field.type === "email") {
    // Regex validasi email sederhana
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(value)) {
      errorMsg = "Format email tidak valid (contoh: nama@email.com).";
    }
  } else if (field.minLength && value.length < field.minLength) {
    errorMsg = `${field.label} minimal ${field.minLength} karakter.`;
  }

  if (errorMsg) {
    inputEl.classList.add("error");
    errorEl.textContent = errorMsg;
    return false;
  } else {
    inputEl.classList.remove("error");
    errorEl.textContent = "";
    return true;
  }
}

/**
 * Validasi semua field form.
 * @returns {boolean} true jika semua valid
 */
function validateForm() {
  const results = formFields.map(validateField);
  return results.every(Boolean);
}

// Hapus error saat user mulai mengetik ulang
formFields.forEach(field => {
  const inputEl = document.getElementById(field.id);
  inputEl.addEventListener("input", () => {
    inputEl.classList.remove("error");
    document.getElementById(field.errorId).textContent = "";
  });
});

contactForm.addEventListener("submit", (e) => {
  e.preventDefault();

  // Sembunyikan pesan sukses sebelumnya
  formSuccess.style.display = "none";

  // Jalankan validasi
  if (!validateForm()) return;

  // Simulasi loading state (pengiriman ke server)
  sendBtn.disabled    = true;
  btnText.style.display   = "none";
  btnLoading.style.display = "inline";

  setTimeout(() => {
    // Reset tombol
    sendBtn.disabled     = false;
    btnText.style.display    = "inline";
    btnLoading.style.display = "none";

    // Tampilkan pesan sukses
    formSuccess.style.display = "block";

    // Reset semua input
    contactForm.reset();

    // Sembunyikan pesan sukses setelah 5 detik
    setTimeout(() => {
      formSuccess.style.display = "none";
    }, 5000);
  }, 1800); // Simulasi delay 1.8 detik
});

/* ============================================================
   7. BACK TO TOP BUTTON
   ============================================================ */

const backToTopBtn = document.getElementById("back-to-top");

/** Tampilkan / sembunyikan tombol berdasarkan posisi scroll */
function handleBackToTop() {
  if (window.scrollY > 400) {
    backToTopBtn.classList.add("visible");
  } else {
    backToTopBtn.classList.remove("visible");
  }
}

window.addEventListener("scroll", handleBackToTop, { passive: true });

backToTopBtn.addEventListener("click", () => {
  window.scrollTo({ top: 0, behavior: "smooth" });
});

/* ============================================================
   8. HIGHLIGHT BARIS JADWAL HARI INI
   ============================================================ */

/**
 * Tandai baris tabel jadwal yang sesuai dengan hari ini
 * sebagai "today-row" secara otomatis.
 */
function highlightTodaySchedule() {
  // Mapping nama hari Indonesia ke indeks (0 = Minggu)
  const hariIndo = ["", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
  const today    = hariIndo[new Date().getDay()]; // "" jika Minggu

  const rows = document.querySelectorAll(".schedule-table tbody tr");
  rows.forEach(row => {
    const dayBadge = row.querySelector(".day-badge");
    if (!dayBadge) return;

    if (dayBadge.textContent.trim() === today) {
      row.classList.add("today-row");
    } else {
      row.classList.remove("today-row");
    }
  });
}

highlightTodaySchedule();

/* ============================================================
   SELESAI — semua modul telah diinisialisasi
   ============================================================ */
